{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
         "${workspaceFolder}/.."
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "env": {
        "OPENAI_API_KEY": "${input:openaiApiKey}"
      }
    }
  ],
  "inputs": [
    {
      "id": "openaiApiKey",
      "type": "promptString",
      "description": "Enter your OpenAI API key",
      "password": true
    }
  ]
}